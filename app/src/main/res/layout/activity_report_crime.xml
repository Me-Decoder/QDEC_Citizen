<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_marginTop="12sp"
    android:layout_marginBottom="12sp"
    android:layout_height="match_parent"
    android:background="#0D1B2A">

    <!-- Toolbar -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#142A45"
        app:title="Report Cyber Crime"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/ic_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- Scroll -->

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- INCIDENT DETAILS -->

            <TextView
                android:text="Incident Details"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"

                android:layout_marginBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>


            <!-- Fraud Type -->

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:endIconMode="dropdown_menu">

                <AutoCompleteTextView
                    android:id="@+id/spFraudType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:hint="Select Fraud Type"
                    android:inputType="none"
                    android:focusable="false"
                    android:textColor="@android:color/white"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Fraud Info Fields (dynamic) -->



            <!-- Dynamic Fraud Fields -->

            <LinearLayout
                android:id="@+id/layoutFraudFields"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>



            <!-- LOCATION -->

            <TextView
                android:text="Location"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>


            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLocation"
                    android:hint="Fetching location..."
                    android:textColor="@android:color/white"
                    android:enabled="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_marginTop="10dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPoliceStation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nearest Police Station"
                    android:textColor="@android:color/white"
                    android:focusable="false"/>

            </com.google.android.material.textfield.TextInputLayout>


            <!-- DESCRIPTION -->

            <TextView
                android:text="Incident Description"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>


            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescription"
                    android:minLines="3"
                    android:hint="Describe the incident"
                    android:textColor="@android:color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

            </com.google.android.material.textfield.TextInputLayout>



            <!-- EVIDENCE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upload Evidence"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"/>


            <GridLayout
                android:id="@+id/evidenceGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:layout_marginTop="12dp">

                <!-- CAMERA -->

                <LinearLayout
                    android:id="@+id/btnCamera"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_height="100dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_camera"
                        app:tint="@android:color/white"/>

                    <TextView
                        android:text="Camera"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        />
                </LinearLayout>


                <!-- GALLERY -->

                <LinearLayout
                    android:id="@+id/btnGallery"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_height="100dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_gallery"
                        app:tint="@android:color/white"/>

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Gallery"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"/>
                </LinearLayout>


                <!-- DOCUMENT -->

                <LinearLayout
                    android:id="@+id/btnDocument"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_height="100dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_file"
                        app:tint="@android:color/white"/>

                    <TextView
                        android:text="Document"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        />


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnAudio"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_height="120dp">

                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp">

                        <View
                            android:id="@+id/micPulse"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:background="@drawable/bg_pulse_ring"
                            android:visibility="gone"/>

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_mic"
                            app:tint="@android:color/white"/>
                    </FrameLayout>

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:id="@+id/tvRecordingTime"
                        android:text="00:00"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:visibility="gone"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Audio"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"/>
                </LinearLayout>

            </GridLayout>



            <!-- Evidence Grid Preview -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerEvidence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"/>



            <!-- SUBMIT -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:text="Submit Cyber Crime Report"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                app:cornerRadius="16dp"
                app:backgroundTint="#F4A100"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>