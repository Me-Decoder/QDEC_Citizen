<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".MyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_qdec_citizen"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_qdec_citizen"
        android:supportsRtl="true"
        android:theme="@style/Theme.QDECCitizen"
        tools:targetApi="31">
        

        <activity
            android:name="com.sujalkatariya.qdec.citizen.ui.MyComplaintsActivity"
            android:exported="false" />
        <activity
            android:name="com.sujalkatariya.qdec2.citizen.ui.EvidenceViewerActivity"
            android:exported="false" />
        <activity
            android:name="com.sujalkatariya.qdec2.citizen.ui.report.ReportCrimeActivity"
            android:exported="false" />
        <activity
            android:name="com.sujalkatariya.qdec2.citizen.ui.home.HomeActivity"
            android:exported="false" />
        <activity
            android:name="com.sujalkatariya.qdec2.citizen.ui.auth.LoginActivity"
            android:exported="false" />
        <activity
            android:name="com.sujalkatariya.qdec2.citizen.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>



        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>


</manifest>